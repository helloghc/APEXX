# Packages a binary built on the host (CGO_ENABLED=0 go build -o deploy/local/apexx ./cmd/apexx).
# Same runtime image as the production Dockerfile; used when the build
# environment cannot reach the Go module proxy (air-gapped CI, TLS-intercepting proxies).
FROM mirror.gcr.io/library/busybox:1.36.1-musl AS busybox
FROM gcr.io/distroless/static-debian12:nonroot
COPY apexx /apexx
COPY --from=busybox /bin/busybox /busybox
USER nonroot:nonroot
ENV APEXX_ADDR=:8080
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD ["/busybox", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/readyz"]
ENTRYPOINT ["/apexx"]
CMD ["serve"]
