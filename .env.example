# Copy to .env (chmod 600) or let deploy/gcp/fetch-secrets.sh write it from Secret Manager.
# Generate fresh values with: deploy/gen-secrets.sh
APEXX_DOMAIN=tienda.example.com
ACME_EMAIL=ops@example.com
CADDY_TLS_MODE=acme
APEXX_IMAGE=us-central1-docker.pkg.dev/PROJECT/apexx/apexx:TAG

POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
SYSTEM_DB_PASSWORD=CHANGE_ME
APEXX_MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# stripe | sandbox (sandbox never charges; development only)
APEXX_PAYMENTS=stripe
# Platform Stripe key, only needed for stores connected through Stripe Connect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APEXX_PLATFORM_FEE_BPS=0

# Sizing for e2-standard-4 (4 vCPU, 16 GB)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MEMORY_LIMIT=8g
# Per app node; docker-compose runs two nodes (apexx, apexx2). Each uses about
# 0.7 GB with 50 000 products; two nodes at 3g plus Postgres fit in 16 GB.
APEXX_CPUS=3
APEXX_MEMORY_LIMIT=3g

# Zero-downtime deploys: seconds a stopping node answers /readyz with 503
# (Caddy stops sending it traffic) before it shuts down. See deploy/rolling.sh.
APEXX_DRAIN=6s

# Optional AI. Without these every AI feature runs deterministically
# (local vectors, quoted answers). Keys go to Secret Manager like the rest.
APEXX_ANTHROPIC_API_KEY=
# APEXX_AI_MODEL=claude-sonnet-5-5        # written answers and texts
# APEXX_AI_MODEL_FAST=claude-haiku-5-5    # context of document chunks
APEXX_EMBEDDINGS=local
VOYAGE_API_KEY=
