{{define "content"}}
<header class="hero"><div class="wrap hero-c">
  <span class="tag-live rise d1"><span class="dot"></span>Resultado · Nuevos canales</span>
  <h1 class="rise d2">Abre canales <span class="mg">sin montar otra plataforma</span>.</h1>
  <p class="sub rise d3">B2C, B2B, marketplace, punto de venta, canales de venta y mercados internacionales — todos con el mismo inventario y la misma tienda. Crece a lo ancho, no a lo caótico.</p>
  <div class="cta-row rise d4"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a><a class="btn btn-ghost btn-lg" href="/#modelos">Ver los modelos →</a></div>
</div></header>

<section style="padding-top:14px">
  <div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Una sola verdad</p>
      <h2>Seis frentes de venta, un inventario.</h2>
      <p>Cada canal nuevo lee y descuenta las mismas existencias. Nada de islas, dobles capturas ni números que no cuadran.</p></div>
    <div class="hub reveal">
      <div class="side">
        <div class="ch">{{template "ic" "cart"}}Tienda B2C</div>
        <div class="ch">{{template "ic" "building"}}Mayoreo y B2B</div>
        <div class="ch">{{template "ic" "users"}}Marketplace</div>
      </div>
      <div class="core"><b>Un inventario</b><span>Existencias, pedidos y clientes — una sola verdad</span></div>
      <div class="side">
        <div class="ch">{{template "ic" "store"}}Punto de venta</div>
        <div class="ch">{{template "ic" "globe"}}Internacional</div>
        <div class="ch">{{template "ic" "chart"}}Canales y feeds</div>
      </div>
    </div>
  </div>
</section>

<section style="padding-top:8px">
  <div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Cada modelo, listo</p>
      <h2>Enciende el canal que te toca, cuando te toca.</h2></div>
    <div class="models">
      <div class="model reveal"><span class="i">{{template "ic" "building"}}</span><b>B2B y mayoreo</b><p>Vende a empresas con crédito, aprobaciones y precios por cliente.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "users"}}</span><b>Marketplace</b><p>Suma vendedores con su portal y sus pagos; tú defines la comisión.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "globe"}}</span><b>Internacional</b><p>Mercados por país con su moneda, impuestos y 6 idiomas.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "store"}}</span><b>Punto de venta</b><p>Vende también en tu tienda física; comparte inventario y clientes.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "chart"}}</span><b>Canales y feeds</b><p>Publica en otros canales sin capturar dos veces.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "box"}}</span><b>Un solo catálogo</b><p>Todo comparte existencias y pedidos; nada de islas desconectadas.</p></div>
    </div>
  </div>
</section>

<section style="padding-top:8px">
  <div class="wrap">
    <div class="band reveal">
      <p class="eyebrow">Crecer a lo ancho, sin caos</p>
      <h2>Más canales, una sola operación.</h2>
      <div class="metrics">
        <div class="metric"><b class="num">6</b><span>Modelos de venta</span><small>en la misma tienda</small></div>
        <div class="metric"><b class="num">1</b><span>Inventario compartido</span><small>sin doble captura</small></div>
        <div class="metric"><b class="num">0</b><span>Plataformas extra que pegar</span><small>todo adentro</small></div>
        <div class="metric"><b class="num">6</b><span>Idiomas de tienda</span><small>dirección propia por idioma</small></div>
      </div>
    </div>
  </div>
</section>

<section style="padding-top:8px"><div class="wrap">
  <div class="close reveal"><h2>Más frentes de venta, una sola operación.</h2>
    <div class="cta-row" style="justify-content:center;margin-top:26px"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a><a class="btn btn-ghost btn-lg" href="/resultado/vender-mas">Volver a «vender más» →</a></div></div>
</div></section>
{{end}}
