{{define "content"}}
<header class="hero"><div class="wrap hero-c">
  <span class="tag-live rise d1"><span class="dot"></span>Para quien empieza</span>
  <h1 class="rise d2">Tu primera tienda, <span class="mg">viva en minutos</span>.</h1>
  <p class="sub rise d3">Sin servidores, sin desarrolladores, sin letras chiquitas. Elige un tema, arrastra tus secciones y publica. Con IA incluida y un sandbox para probar sin miedo.</p>
  <div class="cta-row rise d4"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a><a class="btn btn-ghost btn-lg" href="/s/qa/main/index">Ver una tienda en vivo →</a></div>
</div></header>

<section style="padding-top:12px">
  <div class="wrap">
    <div class="split">
      <div class="copy reveal">
        <p class="eyebrow">Sin código, sin esperar a nadie</p>
        <h2>Arrastra una sección, suéltala y ya está en vivo.</h2>
        <div class="sfeat" style="margin-top:22px;grid-template-columns:1fr">
          <div class="f"><span class="i">{{template "ic" "bolt"}}</span><div><b>Editor por secciones</b><span>Arrastra, suelta y publica. Lo que ves es lo que queda.</span></div></div>
          <div class="f"><span class="i">{{template "ic" "users"}}</span><div><b>Equipo sin costo</b><span>Invita a quien quieras; no cobramos por asiento, nunca.</span></div></div>
          <div class="f"><span class="i">{{template "ic" "card"}}</span><div><b>Cobra desde el día 1</b><span>Tarjeta, OXXO y SPEI con tu propia cuenta de Stripe.</span></div></div>
        </div>
      </div>
      <div class="reveal">
        <div class="edmk">
          <div class="sb">
            <div class="it">{{template "ic" "store"}}Encabezado</div>
            <div class="it">Portada</div>
            <div class="it drag">{{template "ic" "box"}}Productos</div>
            <div class="it">Reseñas</div>
            <div class="it">Pie de página</div>
          </div>
          <div class="cv">
            <div class="blk hero-b">Portada · tema Lienzo</div>
            <div class="blk">Carrusel de categorías</div>
            <div class="blk drop">Suelta «Productos» aquí</div>
          </div>
        </div>
        <p class="mute" style="font-size:13px;margin-top:10px;text-align:center">Cada cambio se publica al instante y guarda la versión anterior.</p>
      </div>
    </div>
  </div>
</section>

<section style="padding-top:8px">
  <div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Hecho para tu giro</p>
      <h2>Empieza con un tema con arte propio.</h2>
      <p>Cuatro temas originales listos para usar; haz el tuyo mientras subes tus fotos.</p></div>
    <div class="themes">
      <div class="theme reveal"><div class="sw" style="background:linear-gradient(135deg,#F6F4F0,#8A5536)"></div><div class="meta"><b>Lienzo</b><span>Moda y accesorios · editorial</span></div></div>
      <div class="theme reveal"><div class="sw" style="background:linear-gradient(135deg,#0B0D12,#2DD4EE)"></div><div class="meta"><b>Voltio</b><span>Tecnología · oscuro y preciso</span></div></div>
      <div class="theme reveal"><div class="sw" style="background:linear-gradient(135deg,#FFFFFF,#1C7536)"></div><div class="meta"><b>Mercadito</b><span>Súper y abarrotes · cercano</span></div></div>
      <div class="theme reveal"><div class="sw" style="background:linear-gradient(135deg,#FBF5F2,#9C3448)"></div><div class="meta"><b>Bálsamo</b><span>Belleza y bienestar · suave</span></div></div>
    </div>
  </div>
</section>

<section style="padding-top:8px"><div class="wrap">
  <div class="close reveal"><h2>Empieza hoy; crece cuando quieras.</h2>
    <div class="cta-row" style="justify-content:center;margin-top:26px"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a><a class="btn btn-ghost btn-lg" href="/tamano/pyme">Y cuando crezcas →</a></div></div>
</div></section>
{{end}}
