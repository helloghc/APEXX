{{define "content"}}
<header class="hero"><div class="wrap hero-c">
  <span class="tag-live rise d1"><span class="dot"></span>Comparar</span>
  <h1 class="rise d2">Lo que incluimos y <span class="mg">otros cobran aparte</span>.</h1>
  <p class="sub rise d3">Una comparación honesta frente a la plataforma tradicional. Sin letras chiquitas.</p>
  <div class="cta-row rise d4"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a></div>
</div></header>
<section style="padding-top:14px"><div class="wrap">
  <div class="cmp-wrap reveal"><table class="cmp">
    <thead><tr><th>Capacidad</th><th class="sh">Shulada</th><th>Plataforma tradicional</th></tr></thead>
    <tbody>
      <tr><td>Asientos del equipo</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}Ilimitados</span></td><td class="no">Suele cobrarse por usuario</td></tr>
      <tr><td>Inteligencia artificial</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}Incluida</span></td><td class="no">Módulo o costo aparte</td></tr>
      <tr><td>Deshacer y versiones</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}En un clic</span></td><td class="no">A menudo manual o inexistente</td></tr>
      <tr><td>Sandbox para probar</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}Incluido</span></td><td class="no">Rara vez disponible</td></tr>
      <tr><td>OXXO y SPEI</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}De fábrica</span></td><td class="no">Depende de extensiones</td></tr>
      <tr><td>Velocidad de publicación</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}Milisegundos</span></td><td class="no">Segundos o minutos</td></tr>
      <tr><td>Servidores que administrar</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}Ninguno</span></td><td class="no">A veces tú los operas</td></tr>
      <tr><td>B2B y mayoreo</td><td class="col-sh"><span class="yes">{{template "ic" "spark"}}En la misma tienda</span></td><td class="no">Módulo aparte</td></tr>
    </tbody>
  </table></div>
  <div class="close reveal" style="margin-top:40px"><h2>Más incluido, menos sorpresas.</h2>
    <div class="cta-row" style="justify-content:center;margin-top:26px"><a class="btn btn-primary btn-lg" href="/empezar">Crear mi tienda</a><a class="btn btn-ghost btn-lg" href="/#incluye">Todo lo que incluye →</a></div></div>
</div></section>
{{end}}
