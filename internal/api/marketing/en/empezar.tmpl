{{define "content"}}
<section class="hero" style="padding-top:34px">
  <div class="wrap start-grid">
    <div class="start-why reveal">
      <span class="tag-live"><span class="dot"></span>Get started with Shulada</span>
      <h1>Open your store with <span class="mg">someone who helps you</span>.</h1>
      <p class="sub">Tell us about your business and someone from Shulada will reach out to open your store, migrate your catalog and give you a tailored quote. No commitment.</p>
      <div class="start-steps">
        <div class="s"><span class="n">1</span><div><b>Tell us about you</b><p>Your industry, how much you sell and what you use today. Two minutes.</p></div></div>
        <div class="s"><span class="n">2</span><div><b>We reach out</b><p>Someone from sales calls or writes, with a tailored quote.</p></div></div>
        <div class="s"><span class="n">3</span><div><b>We migrate and publish</b><p>We bring your catalog (even from VTEX) and your store is live in minutes.</p></div></div>
      </div>
      <div class="start-steps" style="margin-top:28px">
        <div class="s"><span class="n" style="background:none;color:var(--signal);border:1px solid color-mix(in oklab,var(--signal) 40%,var(--line))">✓</span><div><b>Unlimited seats</b><p>We never charge per seat, on any plan.</p></div></div>
        <div class="s"><span class="n" style="background:none;color:var(--signal);border:1px solid color-mix(in oklab,var(--signal) 40%,var(--line))">✓</span><div><b>Everything reversible</b><p>Nothing publishes broken; you can always roll back.</p></div></div>
      </div>
    </div>

    <div class="lead-card reveal">
      <form id="lead-form" novalidate>
        <div class="lead-fields">
          <h2>Tell us about your business</h2>
          <p class="lc-sub">We reply the same business day. Your data is private: <a href="/en/privacidad">Privacy Notice</a>.</p>
          <div class="form-grid">
            <div class="field"><label for="l-name">Name <span class="req">*</span></label><input id="l-name" name="name" autocomplete="name" maxlength="120" required></div>
            <div class="field"><label for="l-company">Company or brand</label><input id="l-company" name="company" autocomplete="organization" maxlength="120"></div>
            <div class="field"><label for="l-email">Email <span class="req">*</span></label><input id="l-email" name="email" type="email" autocomplete="email" maxlength="160" required></div>
            <div class="field"><label for="l-phone">Phone or WhatsApp</label><input id="l-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="+52 55 1234 5678"></div>
            <div class="field"><label for="l-country">Country</label>
              <select id="l-country" name="country">
                <option>Mexico</option><option>Colombia</option><option>Peru</option><option>Chile</option>
                <option>Argentina</option><option>United States</option><option>Spain</option><option>Other</option>
              </select></div>
            <div class="field"><label for="l-industry">What do you sell?</label>
              <select id="l-industry" name="industry">
                <option value="">Choose your industry…</option>
                <option>Fashion & accessories</option><option>Technology & electronics</option><option>Grocery & essentials</option>
                <option>Beauty & wellness</option><option>Home & furniture</option><option>Wholesale / B2B</option>
                <option>Marketplace</option><option>Other</option>
              </select></div>
            <div class="field"><label for="l-volume">Monthly sales (approx.)</label>
              <select id="l-volume" name="volume">
                <option value="">For your quote…</option>
                <option>Just starting</option><option>Under $5k</option><option>$5k – $25k</option>
                <option>$25k – $100k</option><option>$100k – $500k</option><option>Over $500k</option>
              </select></div>
            <div class="field"><label for="l-platform">What do you use today?</label>
              <select id="l-platform" name="platform">
                <option value="">Current platform…</option>
                <option>Nothing yet</option><option>VTEX</option><option>Shopify</option><option>WooCommerce</option>
                <option>Magento</option><option>Custom store</option><option>Other</option>
              </select></div>
            <div class="field full"><label for="l-message">Anything we should know?</label><textarea id="l-message" name="message" maxlength="2000" placeholder="Tell us what you need, how many products you have, timelines…"></textarea></div>
            <div class="field full hp"><label for="l-website">Leave this empty</label><input id="l-website" name="website" tabindex="-1" autocomplete="off"></div>
          </div>
          <div class="lead-submit">
            <p class="lead-err" id="lead-err" role="alert"></p>
            <button class="btn btn-primary btn-lg" type="submit" id="lead-btn" style="width:100%;justify-content:center">I want to be contacted</button>
            <p class="lead-note">By submitting you accept our <a href="/en/privacidad">Privacy Notice</a> and that we may contact you about Shulada. No spam.</p>
          </div>
        </div>
        <div class="lead-ok">
          <svg class="big-mark" width="60" height="60" viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="12" fill="url(#sg)"/><path d="M14 37V24.5A10 10 0 0 1 34 24.5V37" fill="none" stroke="#fff" stroke-width="6.2" stroke-linecap="round"/><circle cx="24" cy="12.2" r="3.4" fill="#FF5B2E"/></svg>
          <h2>Thanks! We'll be in touch.</h2>
          <p>Someone from Shulada will write you shortly with next steps and your quote. Meanwhile, you can browse a live store.</p>
          <div class="cta-row" style="justify-content:center;margin-top:22px"><a class="btn btn-ghost" href="/s/qa/main/index">See a live store →</a></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
(function(){
  var f=document.getElementById('lead-form'); if(!f) return;
  var btn=document.getElementById('lead-btn'), err=document.getElementById('lead-err');
  f.addEventListener('submit', function(e){
    e.preventDefault(); err.textContent='';
    var data={}; new FormData(f).forEach(function(v,k){ data[k]=String(v).trim(); });
    if(!data.name){ err.textContent='Enter your name.'; return; }
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email||'')){ err.textContent='Enter a valid email.'; return; }
    btn.disabled=true; var old=btn.textContent; btn.textContent='Sending…';
    fetch('/v1/leads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
      .then(function(r){ return r.ok ? r.json() : r.json().then(function(p){ throw new Error(p.detail||'Could not send.'); }); })
      .then(function(){ f.classList.add('sent'); window.scrollTo({top:f.getBoundingClientRect().top+window.scrollY-120,behavior:'smooth'}); })
      .catch(function(ex){ err.textContent=ex.message||'Could not send. Try again.'; btn.disabled=false; btn.textContent=old; });
  });
})();
</script>
{{end}}
