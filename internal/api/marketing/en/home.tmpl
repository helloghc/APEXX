{{define "content"}}
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="tag-live rise d1"><span class="dot"></span>Published, live and up to date</span>
      <h1 class="rise d2">The commerce platform that <span class="mg">doesn't slow you down</span>.</h1>
      <p class="sub rise d3">The complete system for brands and wholesalers: storefront, catalog, payments, B2B, marketplace, international and AI. And a buying experience your customers feel is <b>fast, clear and beautiful</b>.</p>
      <div class="cta-row rise d4">
        <a class="btn btn-primary btn-lg" href="/admin/">Sign in to the panel</a>
        <a class="btn btn-ghost btn-lg" href="/s/qa/main/index">See a live store →</a>
      </div>
      <p class="cta-note rise d4">Unlimited seats on every plan. We never charge per seat.</p>
    </div>
    <div class="hero-art">
      <div class="glass rise d3">
        <svg class="big-mark" width="80" height="80" viewBox="0 0 48 48" aria-hidden="true">
          <rect width="48" height="48" rx="12" fill="url(#sg)"/>
          <path d="M14 37V24.5A10 10 0 0 1 34 24.5V37" fill="none" stroke="#fff" stroke-width="6.2" stroke-linecap="round"/>
          <circle cx="24" cy="12.2" r="3.4" fill="#FF5B2E"/>
        </svg>
        <div class="pub"><span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><path d="M20 6 9 17l-5-5"/></svg></span><span><span class="lead">Change published</span><small>Home · Lienzo theme</small></span><span class="ms">2 ms</span></div>
        <div class="pub"><span class="ic warm"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg></span><span><span class="lead">Previous version saved</span><small>Undo in one click</small></span><span class="ms">ready</span></div>
        <div class="pub"><span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></span><span><span class="lead">Store loading</span><small>Shopper's first view</small></span><span class="ms">0.6 s</span></div>
      </div>
    </div>
  </div>
</header>

<div class="proof">
  <div class="wrap proof-row">
    <span class="lbl">Built and tested at scale</span>
    <div class="items">
      <div class="stat"><b class="num">&lt; 1 s</b><span>Store load</span></div>
      <div class="stat"><b class="num">2 ms</b><span>Publish a change</span></div>
      <div class="stat"><b class="num">0</b><span>Downtime on updates</span></div>
      <div class="stat"><b class="num">50,000+</b><span>Products per store</span></div>
      <div class="stat"><b class="num">6</b><span>Storefront languages</span></div>
      <div class="stat"><b class="num">100%</b><span>Reversible</span></div>
    </div>
  </div>
</div>

<section id="suite">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow">One complete suite</p>
      <h2>All of commerce in one system, not ten services glued together.</h2>
      <p>Four areas that work together, with the same data and the same speed. Every number is exact; every change, reversible.</p>
    </div>
    <div class="suite">
      <a class="card reveal" href="/en/tienda"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span><h3>Storefront & experience</h3><p>Section editor, 4 original themes, content and a fast, AI-powered buying experience.</p><div class="tags"><span>Editor</span><span>Themes</span><span>Search</span><span>Blog</span></div></a>
      <a class="card reveal" href="/en/pagos"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span><h3>Operations & orders</h3><p>Catalog, inventory, orders, live shipping, reversible payments and returns — all exact.</p><div class="tags"><span>Catalog</span><span>Orders</span><span>Payments</span><span>Shipping</span></div></a>
      <a class="card reveal" href="/en/b2b"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 21V7l9-4 9 4v14"/><path d="M9 21v-6h6v6"/></svg></span><h3>B2B & marketplace</h3><p>Credit, approvals, quotes and punchout for businesses; sellers with their own portal.</p><div class="tags"><span>Credit</span><span>Quotes</span><span>Sellers</span></div></a>
      <a class="card reveal" href="/en/ia"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></span><h3>Growth & AI</h3><p>Promotions, loyalty, subscriptions, international markets, marketing, analytics and AI included.</p><div class="tags"><span>Promos</span><span>Loyalty</span><span>AI</span><span>Analytics</span></div></a>
    </div>
  </div>
</section>

<section id="velocidad" style="padding-top:8px">
  <div class="wrap">
    <div class="band reveal">
      <p class="eyebrow">We don't promise it, we measure it</p>
      <h2>Speed measured in milliseconds.</h2>
      <p>Real numbers from our scale and zero-downtime deployment tests, on a 50,000-product store.</p>
      <div class="metrics">
        <div class="metric"><b class="num">2 ms</b><span>Publish a change</span><small>home live</small></div>
        <div class="metric"><b class="num">0.6 s</b><span>First store load</span><small>shopper view</small></div>
        <div class="metric"><b class="num">0</b><span>Failed requests on update</span><small>154,689 in the test</small></div>
        <div class="metric"><b class="num">13 s</b><span>Clone a full store</span><small>50,000 products</small></div>
      </div>
    </div>
  </div>
</section>

<section id="modelos" style="padding-top:8px">
  <div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Solutions</p>
      <h2>One system for every business model.</h2>
      <p>Run several models at once, without gluing different platforms together.</p></div>
    <div class="models">
      <div class="model reveal"><span class="i">{{template "ic" "cart"}}</span><b>Direct to consumer (B2C)</b><p>A direct store with a fast, beautiful buying experience.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "building"}}</span><b>Wholesale & B2B</b><p>Credit, approvals, per-customer pricing and punchout.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "users"}}</span><b>Marketplace</b><p>Add sellers with their own portal, products and payouts.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "truck"}}</span><b>Omnichannel</b><p>Point of sale, channels and feeds share one inventory.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "globe"}}</span><b>International</b><p>Markets per country with currency, taxes and 6 languages.</p></div>
      <div class="model reveal"><span class="i">{{template "ic" "flask"}}</span><b>Subscriptions</b><p>Recurring charges, reorders and memberships.</p></div>
    </div>
  </div>
</section>

<section id="confianza" style="padding-top:8px">
  <div class="wrap">
    <div class="band reveal">
      <p class="eyebrow">Why trust a young platform?</p>
      <h2>Because we show you everything, not borrowed logos.</h2>
      <p>We're new and we say so upfront. We'd rather earn your trust with verifiable facts you can check today than with filler testimonials.</p>
      <div class="metrics">
        <div class="metric"><b class="num">0</b><span>Card data at Shulada</span><small>you charge with your Stripe</small></div>
        <div class="metric"><b class="num">100%</b><span>Reversible</span><small>undo in one click</small></div>
        <div class="metric"><b class="num">24/7</b><span>Infrastructure we operate</span><small>so you don't</small></div>
        <div class="metric"><b class="num">1</b><span>Open demo store</span><small>browse it, no sign-up</small></div>
      </div>
      <div class="cta-row" style="margin-top:28px"><a class="btn btn-primary btn-lg" href="/demo">Try the live panel →</a><a class="btn btn-sko btn-lg" href="/s/qa/main/index" style="color:#fff;border-color:rgba(255,255,255,.3)">See a live store</a></div>
    </div>
    <div class="trustbar reveal">
      <span>Payments by Stripe</span><span>Cards & local methods</span><span>Installments</span><span>Tax included</span><span>Made in Mexico</span><span>For LATAM</span>
    </div>
  </div>
</section>

<section style="padding-top:8px">
  <div class="wrap">
    <div class="close reveal">
      <svg width="64" height="64" viewBox="0 0 48 48" aria-hidden="true" style="margin:0 auto;display:block;filter:drop-shadow(0 16px 28px rgba(39,26,110,.3))">
        <rect width="48" height="48" rx="12" fill="url(#sg)"/>
        <path d="M14 37V24.5A10 10 0 0 1 34 24.5V37" fill="none" stroke="#fff" stroke-width="6.2" stroke-linecap="round"/>
        <circle cx="24" cy="12.2" r="3.4" fill="#FF5B2E"/>
      </svg>
      <h2>Your store, live in minutes.</h2>
      <p>Sign in, pick a theme and publish. No servers to manage, no downtime, no fine print per user.</p>
      <div class="cta-row" style="justify-content:center;margin-top:30px">
        <a class="btn btn-primary btn-lg" href="/en/empezar">Create my store</a>
        <a class="btn btn-ghost btn-lg" href="/s/qa/main/index">See a live store →</a>
      </div>
    </div>
  </div>
</section>
{{end}}
