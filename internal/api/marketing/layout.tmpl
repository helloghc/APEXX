{{/* mitem: one mega-menu link with an icon. */}}
{{define "mitem"}}<a class="item" href="{{.href}}" role="menuitem"><span class="i">{{template "ic" .ic}}</span><span><b>{{.t}}</b><span>{{.d}}</span></span></a>{{end}}

{{/* ic: a named inline icon. */}}
