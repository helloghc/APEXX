{{define "content"}}
<div>
<p class="eyebrow">{{if .Query}}Búsqueda{{else}}Catálogo{{end}}</p>
<h1>{{if .Query}}Resultados para “{{.Query}}”{{else}}Todos los productos{{end}}</h1>
{{if not .Products}}<p class="empty">No encontramos productos{{if .Query}} para “{{.Query}}”. Revisa la ortografía o prueba con otra palabra{{end}}.</p>{{end}}
<ul class="pgrid cols-4">{{range .Products}}{{template "pcard" .}}{{end}}</ul>
{{with .Next}}<p class="more"><a class="btn btn-ghost" href="{{$.Base}}/c?q={{$.Query}}&amp;cursor={{.}}">Ver más productos</a></p>{{end}}
</div>
{{end}}
