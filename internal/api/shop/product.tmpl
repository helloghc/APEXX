{{define "content"}}
<div>
<nav class="crumbs" aria-label="Ruta">{{range .Crumbs}}<a href="{{.URL}}">{{.Label}}</a> / {{end}}{{.P.Title}}</nav>
<div class="pdp">
{{if .Cover}}<div class="pdp-gallery">{{.Cover}}{{if .Gallery}}<div class="pdp-thumbs">{{range .Gallery}}{{.}}{{end}}</div>{{end}}</div>{{else}}<div class="ph ph-{{.P.Tone}}" aria-hidden="true"><span>{{.P.Initial}}</span></div>{{end}}
<div class="pdp-info">
{{with .P.Brand}}<p class="eyebrow">{{if $.P.BrandURL}}<a href="{{$.P.BrandURL}}">{{.}}</a>{{else}}{{.}}{{end}}</p>{{end}}
<h1>{{.P.Title}}</h1>
{{with .SoldBy}}<p class="muted soldby">Vendido y enviado por <strong>{{.}}</strong></p>{{end}}
<form class="buy" data-buy>
<p class="price big" data-price-out>{{if .CompareAt}}<span class="sale">{{.Price}}</span> <s>{{.CompareAt}}</s>{{else}}{{.Price}}{{end}}</p>
<fieldset><legend>Elige una opción</legend><div class="opts">
{{range $i, $v := .P.Variants}}<label class="opt"><input type="radio" name="sku" value="{{$v.SKU}}" data-title="{{$.P.Title}} · {{$v.Title}}" data-price="{{$v.Price}}" data-compare="{{$v.CompareAt}}" data-available="{{$v.Available}}"{{if $v.Img}} data-img="{{$v.Img}}" data-imgset="{{$v.ImgSet}}"{{end}} {{if eq $i $.FirstAvailable}}checked{{end}} {{if eq $v.Available 0}}disabled{{end}}>
<span>{{$v.Title}}<small>{{if eq $v.Available 0}}Agotado{{else if $v.Preorder}}Preventa{{else}}{{$v.Available}} disponibles{{end}}</small></span></label>{{end}}
</div></fieldset>
{{with .Sub}}<fieldset class="subchoice"><legend>¿Cómo lo quieres?</legend>
<label class="opt"><input type="radio" name="mode" value="" checked><span>Compra única</span></label>
<label class="opt"><input type="radio" name="mode" value="sub"><span>Suscríbete{{with .Percent}} y ahorra {{.}}%{{end}}<small>Entrega automática. Pausa, salta o cancela cuando quieras.</small></span></label>
<label class="subplan" for="plan">Entrega <select id="plan" name="plan">{{range .Plans}}<option value="{{.id}}">{{.label}}</option>{{end}}</select></label>
</fieldset>{{end}}
{{if .Customs}}<fieldset class="customs" data-customs><legend>Personaliza</legend>
{{range .Customs}}<div class="field">{{if eq .Kind "checkbox"}}<label class="check"><input type="checkbox" data-custom="{{.ID}}" data-label="{{.Label}}" value="true"> {{.Label}}{{with .Price}} (+{{.}}){{end}}</label>
{{else if eq .Kind "select"}}<label for="cu-{{.ID}}">{{.Label}}</label><select id="cu-{{.ID}}" data-custom="{{.ID}}" data-label="{{.Label}}"{{if .Required}} data-required{{end}}>{{if not .Required}}<option value="">Sin elegir</option>{{else}}<option value="">Elige una opción</option>{{end}}{{range .Choices}}<option value="{{.ID}}">{{.Label}}{{with .Price}} (+{{.}}){{end}}</option>{{end}}</select>
{{else}}<label for="cu-{{.ID}}">{{.Label}}{{with .Price}} (+{{.}}){{end}}{{if not .Required}} (opcional){{end}}</label><input id="cu-{{.ID}}" data-custom="{{.ID}}" data-label="{{.Label}}" maxlength="{{.MaxLength}}" autocomplete="off"{{if .Required}} data-required{{end}}>{{end}}
{{with .Help}}<small class="muted">{{.}}</small>{{end}}</div>
{{end}}</fieldset>{{end}}
<div class="qtyrow"><label for="qty">Cantidad <input id="qty" name="qty" type="number" min="{{.QtyMin}}" step="{{.QtyStep}}" max="{{if .QtyMax}}{{.QtyMax}}{{else}}9999{{end}}" value="{{.QtyMin}}" inputmode="numeric"></label>
<button class="btn" type="submit" {{if .SoldOut}}disabled{{end}}>{{if .SoldOut}}Agotado{{else if .PreShips}}Apartar en preventa{{else}}Agregar al carrito{{end}}</button></div>
{{with .PreShips}}<p class="note preorder" data-preorder>Preventa: se envía a partir del {{.}}.{{with $.PreDeposit}} Hoy pagas el {{.}}% y el resto cuando esté listo para enviarse.{{end}}</p>{{end}}
<p class="note" role="status" data-buy-status></p>
{{if gt .QtyStep 1}}<p class="muted">Se vende en múltiplos de {{.QtyStep}}.</p>{{else if gt .QtyMin 1}}<p class="muted">Compra mínima: {{.QtyMin}} piezas.</p>{{end}}
{{if .Volume}}<table class="specs volume"><caption>Precio por volumen</caption><tbody>{{range .Volume}}<tr><th scope="row">{{.Name}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table>{{end}}
</form>
<button type="button" class="wish" data-wish="{{.Handle}}" aria-pressed="false"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.6A4 4 0 0 1 12 8a4 4 0 0 1 7 2.4C19 15.6 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span data-wish-text>Guardar en favoritos</span></button>
<ul class="perks"><li>Envío gratis desde $1,499</li><li>Cambios sin costo durante 30 días</li><li>Pago seguro con Stripe</li></ul>
{{if .Kit}}<div class="desc"><h2>Este kit incluye</h2><table class="specs kit"><tbody>{{range .Kit}}<tr><th scope="row">{{.Name}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table></div>{{end}}
{{with .P.Description}}<div class="desc"><h2>Descripción</h2><p>{{.}}</p></div>{{end}}
{{if .Specs}}<div class="desc"><h2>Especificaciones</h2><table class="specs"><tbody>{{range .Specs}}<tr><th scope="row">{{.Name}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table></div>{{end}}
{{range .Extras}}<div class="desc"><h2>{{.Title}}</h2><table class="specs"><tbody>{{range .Rows}}<tr><th scope="row">{{.Name}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table></div>{{end}}
</div></div>
<section class="reviews" id="opiniones" aria-labelledby="rv-h">
<h2 id="rv-h">Opiniones</h2>
{{if .Reviews.Count}}<p class="rv-sum"><span class="stars" role="img" aria-label="{{.Average}} de 5 estrellas">{{stars .Reviews.Average}}</span> <strong>{{.Average}}</strong> <span class="muted">{{.Reviews.Count}} {{if eq .Reviews.Count 1}}opinión{{else}}opiniones{{end}}</span></p>
<ul class="rv-list">{{range .Reviews.Items}}<li><p><span class="stars" role="img" aria-label="{{.Rating}} de 5 estrellas">{{stars .Rating}}</span>{{with .Title}} <strong>{{.}}</strong>{{end}}</p><p>{{.Body}}</p><p class="muted">{{.Author}}{{if .Verified}} · Compra verificada{{end}} · {{day .CreatedAt}}</p>{{with .Reply}}<p class="rv-reply"><strong>Respuesta de la tienda:</strong> {{.}}</p>{{end}}</li>{{end}}</ul>
{{else}}<p class="muted">Todavía no hay opiniones de este producto. Sé la primera persona en opinar.</p>{{end}}
<details class="rv-form"><summary class="btn ghost">Escribir una opinión</summary>
<form data-review-form="{{.Handle}}">
<fieldset class="rv-stars"><legend>Tu calificación</legend>{{range $n := stars5}}<input type="radio" name="rating" id="rv-s{{$n}}" value="{{$n}}"><label for="rv-s{{$n}}" title="{{$n}} estrellas"><span class="sr">{{$n}} estrellas</span><span aria-hidden="true">★</span></label>{{end}}</fieldset>
<div class="field"><label for="rv-title">Título (opcional)</label><input id="rv-title" name="title" type="text" maxlength="100"></div>
<div class="field"><label for="rv-body">Tu opinión</label><textarea id="rv-body" name="body" rows="4" minlength="10" maxlength="2000" required></textarea></div>
<div class="field"><label for="rv-name">Tu nombre</label><input id="rv-name" name="name" type="text" maxlength="60" autocomplete="name" required></div>
<div class="field"><label for="rv-email">Tu correo (no se publica)</label><input id="rv-email" name="email" type="email" autocomplete="email" required></div>
<button class="btn" type="submit">Enviar opinión</button>
<p class="note" role="status" data-review-status></p>
</form></details>
</section>
{{if .Accessories}}<section class="pdp-related" aria-labelledby="rel-acc"><h2 id="rel-acc">Combínalo con</h2><ul class="pgrid cols-4">{{range .Accessories}}{{template "pcard" .}}{{end}}</ul></section>{{end}}
{{if .Similar}}<section class="pdp-related" aria-labelledby="rel-sim"><h2 id="rel-sim">Productos similares</h2><ul class="pgrid cols-4">{{range .Similar}}{{template "pcard" .}}{{end}}</ul></section>{{end}}
</div>
<script type="application/ld+json">{{.JSONLD}}</script>
{{end}}
