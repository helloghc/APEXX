{{define "content"}}
<div class="acct">
{{if or (eq .View "login") (eq .View "code")}}
<h1>{{.Title}}</h1>
<div class="checkout">
<div>
{{with .Notice}}<p class="acct-ok" role="status">{{.}}</p>{{end}}
{{with .Error}}<p class="error" role="alert">{{.}}</p>{{end}}
{{if eq .View "code"}}
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="verificar"><input type="hidden" name="email" value="{{.Email}}">
<fieldset><legend>Código de acceso</legend>
<p class="muted">Lo enviamos a <strong>{{.Email}}</strong>.</p>
<div class="field"><label for="codigo">Código de 6 dígitos</label><input id="codigo" name="codigo" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus></div>
<button class="btn" type="submit">Entrar</button>
</fieldset>
</form>
<form method="post" action="{{.Base}}/cuenta" class="acct-inline">
<input type="hidden" name="accion" value="codigo"><input type="hidden" name="email" value="{{.Email}}">
<button class="linkbtn" type="submit">Enviar otro código</button> · <a href="{{.Base}}/cuenta">Usar otro correo</a>
</form>
{{else}}
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="codigo">
<fieldset><legend>Entra o crea tu cuenta</legend>
<p class="muted">Escribe tu correo y te enviamos un código. No necesitas contraseña.</p>
<div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="email" value="{{.Email}}" required></div>
<button class="btn" type="submit">Enviarme un código</button>
</fieldset>
</form>
<details class="acct-alt"><summary>Entrar con contraseña</summary>
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="entrar">
<fieldset>
<div class="field"><label for="email2">Correo</label><input id="email2" name="email" type="email" autocomplete="username" value="{{.Email}}" required></div>
<div class="field"><label for="contrasena">Contraseña</label><input id="contrasena" name="contrasena" type="password" autocomplete="current-password" required></div>
<button class="btn btn-ghost" type="submit">Entrar</button>
</fieldset>
</form>
</details>
{{end}}
</div>
<aside class="summary" aria-label="Tu cuenta"><h2>Con tu cuenta puedes</h2>
<p>Ver tus pedidos y rastrear cada envío.</p><p>Descargar tus facturas.</p><p>Guardar tus direcciones para comprar más rápido.</p>
<p class="muted">Si ya compraste como invitado, entra con el mismo correo y verás esos pedidos.</p></aside>
</div>
{{else}}
<p class="crumbs"><a href="{{.Base}}/index">Inicio</a> / {{if eq .View "home"}}Mi cuenta{{else}}<a href="{{.Base}}/cuenta">Mi cuenta</a> / {{.Title}}{{end}}</p>
<h1>{{.Title}}</h1>
<nav class="acct-nav" aria-label="Mi cuenta">
<a href="{{.Base}}/cuenta"{{if or (eq .View "home") (eq .View "order")}} aria-current="page"{{end}}>Pedidos</a>
<a href="{{.Base}}/cuenta?ver=direcciones"{{if eq .View "addresses"}} aria-current="page"{{end}}>Direcciones</a>
<a href="{{.Base}}/cuenta?ver=listas"{{if eq .View "lists"}} aria-current="page"{{end}}>Mis listas</a>
{{with .Company}}<a href="{{$.Base}}/cuenta?ver=empresa"{{if eq $.View "company"}} aria-current="page"{{end}}>Mi empresa</a>{{end}}
<a href="{{.Base}}/cuenta?ver=tarjetas"{{if eq .View "cards"}} aria-current="page"{{end}}>Mis tarjetas</a>
<a href="{{.Base}}/cuenta?ver=puntos"{{if eq .View "loyalty"}} aria-current="page"{{end}}>Mis puntos</a>
{{if .Registries}}<a href="{{.Base}}/cuenta?ver=mesas"{{if eq .View "registries"}} aria-current="page"{{end}}>Mesa de regalos</a>{{end}}
<a href="{{.Base}}/cuenta?ver=datos"{{if eq .View "profile"}} aria-current="page"{{end}}>Mis datos</a>
<form method="post" action="{{.Base}}/cuenta"><input type="hidden" name="accion" value="salir"><button class="linkbtn" type="submit">Cerrar sesión</button></form>
</nav>
{{with .Notice}}<p class="acct-ok" role="status">{{.}}</p>{{end}}
{{with .Error}}<p class="error" role="alert">{{.}}</p>{{end}}

{{if eq .View "registries"}}<div data-my-registries><p class="muted">Cargando…</p></div>{{end}}

{{if eq .View "loyalty"}}{{with .Loyalty}}
<div class="acct-box" data-loyalty><p class="big"><strong>{{.Points}}</strong> puntos</p><p class="muted">Valen {{.Value}} en saldo a favor.{{with .Tier}} Nivel: <strong>{{.}}</strong>.{{end}}{{with .NextTier}} Te faltan {{$.Loyalty.ToNext}} en compras para el nivel {{.}}.{{end}}</p>{{with .Rule}}<p class="muted">Ganas {{.}} pagado.</p>{{end}}</div>
{{if and .Active (ge .Points .MinRedeem)}}<form class="acct-box" data-redeem><h2>Canjear puntos</h2><div class="field"><label for="redeem-points">Puntos a canjear (mínimo {{.MinRedeem}})</label><input id="redeem-points" name="points" type="number" min="{{.MinRedeem}}" max="{{.Points}}" value="{{.Points}}" inputmode="numeric"></div><button class="btn" type="submit">Convertir en saldo a favor</button><p class="note" role="status" data-redeem-status></p></form>{{end}}
<table><thead><tr><th>Fecha</th><th>Movimiento</th><th class="num">Puntos</th></tr></thead><tbody>{{range .Entries}}<tr><td>{{.Date}}</td><td>{{.Note}}</td><td class="num">{{if gt .Points 0}}+{{end}}{{.Points}}</td></tr>{{else}}<tr><td colspan="3" class="muted">Aún no tienes movimientos.</td></tr>{{end}}</tbody></table>
{{end}}{{end}}
{{if eq .View "cards"}}
<p class="muted">Tarjetas que guardaste al pagar. La tienda solo guarda una referencia segura de tu banco, nunca el número completo.</p>
{{range .Cards}}<div class="acct-box" data-card="{{.ID}}"><p><strong>{{.Brand}} •••• {{.Last4}}</strong>{{if .ExpYear}} · vence {{.ExpMonth}}/{{.ExpYear}}{{end}}</p><button class="linkbtn" type="button" data-card-delete>Quitar tarjeta</button><p class="note" role="status" data-card-status></p></div>
{{else}}<p>No tienes tarjetas guardadas. Al pagar, marca «Guardar esta tarjeta para mi próxima compra».</p>{{end}}
{{end}}
{{if eq .View "company"}}{{with .Portal}}
<div class="acct-box"><h2>Tu mes</h2>
<p>Compras a crédito este mes: <strong>{{.Spent}}</strong>{{with .Cap}} de tu tope de {{.}}{{end}}.</p>
{{if $.Company.LocationName}}<p>Sucursal {{$.Company.LocationName}}: {{.BranchSpent}}{{with .BranchCap}} de {{.}}{{end}} este mes.</p>{{end}}
{{with .Available}}<p class="muted">Crédito disponible de la empresa: {{.}}.</p>{{end}}
{{if $.Company.Approver}}<p class="muted">Apruebas compras de nivel {{$.Company.ApproverLevel}}.</p>{{end}}
</div>
<h2>Solicitudes de aprobación</h2>
{{if .Requests}}<div class="scrollx"><table><thead><tr><th>Fecha</th><th>Quién</th><th>Motivo</th><th>Nivel</th><th>Estado</th><th class="num">Total</th></tr></thead><tbody>
{{range .Requests}}<tr data-request="{{.ID}}"><td>{{.Date}}</td><td>{{.Requester}}</td><td>{{.Reason}}</td><td>{{.Level}}</td><td>{{.Status}}{{if .Pending}} <button class="linkbtn" type="button" data-request-cancel data-confirm="¿Cancelar esta solicitud?">Cancelar</button>{{end}}</td><td class="num">{{.Total}}</td></tr>
{{end}}</tbody></table></div>{{else}}<p class="muted">Ninguna solicitud todavía.</p>{{end}}
{{if $.Company.Admin}}
{{if and .Credit .Autopay}}<h2>Pago automático</h2>
<div class="acct-box" data-autopay>
{{if .Autopay.On}}<p>Activo: cobramos el saldo vencido de tu empresa a la tarjeta guardada el día que vence. Te avisamos {{.Autopay.ReminderDays}} días antes.</p>
<div class="subactions"><button class="btn ghost" type="button" data-autopay-stop data-confirm="¿Apagar el pago automático? Tendrás que pagar por transferencia.">Apagar pago automático</button></div>
{{else}}<p>Guarda una tarjeta de tu empresa y cobraremos el saldo vencido el día que vence. Te avisamos antes de cada cobro.</p>
{{with .Autopay.Error}}<p class="error">{{.}}</p>{{end}}
<form data-autopay-form><div data-autopay-card></div><div class="subactions"><button class="btn" type="submit">Guardar tarjeta y activar</button></div></form>{{end}}
<p class="note" role="status" data-autopay-status></p>
</div>{{end}}
<h2>Compradores de la empresa</h2>
<p class="muted">Como administrador, decides quién compra, quién aprueba y hasta cuánto al mes. El crédito y las reglas los define la tienda.</p>
<form class="members" data-members>
<div class="scrollx"><table><thead><tr><th>Correo</th><th>Tope al mes</th><th>Sucursal</th><th>Aprueba (nivel)</th><th>Administra</th><th>Ausente hasta</th><th>Suplente</th><th></th></tr></thead><tbody data-member-rows>
{{range .Members}}<tr data-member><td><input type="email" name="email" value="{{.Email}}" aria-label="Correo" required></td>
<td><input name="cap" inputmode="decimal" value="{{if .MonthlyLimit}}{{plain .MonthlyLimit}}{{end}}" placeholder="Sin tope" aria-label="Tope al mes"></td>
<td><select name="location" aria-label="Sucursal"><option value="">Empresa</option>{{$loc := .Location}}{{range $.Portal.Locations}}<option value="{{.ID}}"{{if eq .ID $loc}} selected{{end}}>{{.Name}}</option>{{end}}</select></td>
<td><select name="level" aria-label="Aprueba"><option value="0">No</option>{{$lv := .Level}}{{range $n := levels}}<option value="{{$n}}"{{if eq $n $lv}} selected{{end}}>{{$n}}</option>{{end}}</select></td>
<td><input type="checkbox" name="admin"{{if .Admin}} checked{{end}} aria-label="Administra"></td>
<td><input type="date" name="away" value="{{.AwayUntil}}" aria-label="Ausente hasta"></td>
<td><input type="email" name="substitute" value="{{.Substitute}}" aria-label="Suplente"></td>
<td><button class="linkbtn" type="button" data-member-remove>Quitar</button></td></tr>
{{end}}</tbody></table></div>
<div class="subactions"><button class="btn ghost" type="button" data-member-add>Agregar comprador</button><button class="btn" type="submit">Guardar compradores</button></div>
<p class="note" role="status" data-members-status></p>
</form>
{{end}}
{{end}}{{end}}

{{if eq .View "lists"}}
<p class="muted">Guarda desde tu carrito los productos que compras seguido y vuelve a pedirlos en un paso. Los precios son siempre los de hoy.</p>
{{if .Lists}}<ul class="lists">{{range .Lists}}<li class="acct-box" data-reorder="{{.ID}}"><h2>{{.Name}}{{if .Shared}} <small class="muted">· de tu empresa</small>{{end}}</h2>
<table><thead><tr><th>Producto</th><th class="num">Cantidad</th></tr></thead><tbody>{{range .Lines}}<tr data-sku="{{.SKU}}" data-qty="{{.Qty}}"><td>{{.Title}}{{if not .Available}} <small class="muted">· agotado</small>{{end}}</td><td class="num">{{.Qty}}</td></tr>{{end}}</tbody></table>
<div class="subactions"><button class="btn" type="button" data-reorder-add>Agregar todo al carrito</button><button class="btn ghost" type="button" data-reorder-delete data-confirm="¿Borrar esta lista?">Borrar lista</button></div>
<p class="note" role="status" data-reorder-status></p></li>{{end}}</ul>
{{else}}<p>Todavía no tienes listas. En tu carrito usa “Guardar como lista”.</p>{{end}}
{{end}}
{{if eq .View "home"}}
<p class="muted">{{if .Customer.Name}}Hola, {{.Customer.Name}}. {{end}}Sesión iniciada como {{.Customer.Email}}.</p>
{{if .Orders}}
<table><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th class="num">Total</th></tr></thead><tbody>
{{range .Orders}}<tr><td><a href="{{$.Base}}/cuenta?pedido={{.ID}}">#{{.Number}}</a><br><span class="muted">{{.Items}} {{if eq .Items 1}}pieza{{else}}piezas{{end}}</span></td><td>{{.Date}}</td><td>{{.Status}}</td><td class="num">{{.Total}}</td></tr>
{{end}}</tbody></table>
{{with .NextPage}}<p class="more"><a class="btn btn-ghost" href="{{$.Base}}/cuenta?cursor={{.}}">Ver pedidos anteriores</a></p>{{end}}
{{else}}
<p class="empty">Todavía no tienes pedidos con este correo.</p>
<p><a class="btn" href="{{.Base}}/c">Ver productos</a></p>
{{end}}

{{else if eq .View "order"}}
{{with .Order}}
<p class="muted">{{.Date}} · <strong>{{.Status}}</strong></p>
<div class="checkout">
<div>
<table><thead><tr><th>Producto</th><th class="num">Cant.</th><th class="num">Total</th></tr></thead><tbody>
{{range .Lines}}<tr><td>{{.Title}}</td><td class="num">{{.Qty}}</td><td class="num">{{.Total}}</td></tr>
{{end}}</tbody></table>
{{range .Shipments}}
<section class="acct-box" aria-label="Envío {{.Number}}"><h2>Envío {{.Number}} · {{.Status}}</h2>
<p class="muted">{{range $i, $it := .Items}}{{if $i}}, {{end}}{{$it.Qty}} × {{$it.Title}}{{end}}</p>
{{if .Tracking}}<p>{{with .Carrier}}{{.}} · {{end}}Guía <strong>{{.Tracking}}</strong>{{with .Date}} · {{.}}{{end}}</p>{{end}}
{{with .URL}}<p><a class="btn btn-ghost" href="{{.}}" rel="noopener noreferrer" target="_blank">Rastrear envío</a></p>{{end}}
</section>
{{end}}
{{if .Downloads}}<section class="acct-box" aria-label="Tus descargas" data-downloads><h2>Tus descargas</h2><ul class="downloads">
{{range .Downloads}}<li>{{if .URL}}<a class="btn btn-ghost" href="{{.URL}}" download="{{.Filename}}">{{.Filename}}</a> <span class="muted">{{.Size}} · te quedan {{.Left}} de {{.Max}} descargas, hasta el {{.Until}}</span>{{else}}<span>{{.Filename}}</span> <span class="muted">{{if .Revoked}}Ya no está disponible.{{else}}El enlace venció o se usó todas las veces. Escríbenos y te damos uno nuevo.{{end}}</span>{{end}}</li>
{{end}}</ul></section>{{end}}
{{if .Notes}}<section class="acct-box" aria-label="Mensajes de la tienda"><h2>Mensajes de la tienda</h2>
{{range .Notes}}<p>{{.Body}}<br><span class="muted">{{.Date}}</span></p>{{end}}</section>{{end}}
{{if eq .VoucherKind "oxxo"}}<section class="acct-box" aria-label="Pago pendiente"><h2>Paga en OXXO</h2><p>Referencia: <strong>{{.VoucherRef}}</strong>. Paga {{.Total}} antes del {{.VoucherUntil}}.</p>{{with .VoucherURL}}<p><a href="{{.}}" target="_blank" rel="noopener noreferrer">Ver ficha para imprimir</a></p>{{end}}</section>
{{else if eq .VoucherKind "spei"}}<section class="acct-box" aria-label="Pago pendiente"><h2>Paga por transferencia SPEI</h2><p>CLABE: <strong>{{.VoucherCLABE}}</strong>{{with .VoucherBank}} ({{.}}){{end}}{{with .VoucherRef}} · referencia {{.}}{{end}}. Transfiere {{.Total}} antes del {{.VoucherUntil}}.</p>{{with .VoucherURL}}<p><a href="{{.}}" target="_blank" rel="noopener noreferrer">Ver instrucciones</a></p>{{end}}</section>{{end}}
{{if .Returns}}<section class="acct-box" aria-label="Devoluciones"><h2>Devoluciones</h2>
{{range .Returns}}<p>{{.Number}} · {{.Status}}{{with .LabelTracking}} · guía {{.}}{{end}}{{with .LabelURL}} · <a href="{{.}}" target="_blank" rel="noopener noreferrer">Imprimir guía</a>{{end}}</p>{{end}}</section>{{end}}
{{if .Returnable}}<section class="acct-box" aria-label="Devolver productos"><h2>Devolver productos</h2>
{{with .ReturnNote}}<p class="muted">{{.}}</p>{{end}}
<form data-return-form="{{.ID}}">
<table><thead><tr><th>Producto</th><th class="num">Cantidad</th></tr></thead><tbody>
{{range .Returnable}}<tr><td>{{.Title}}</td><td class="num"><input type="number" min="0" max="{{.Max}}" value="0" data-line="{{.Line}}" aria-label="Cantidad a devolver de {{.Title}}" style="width:5rem"></td></tr>{{end}}
</tbody></table>
<div class="field"><label for="ret-reason">Motivo</label><select id="ret-reason" name="reason"><option value="size">Talla o medida</option><option value="defective">Defectuoso o dañado</option><option value="not_as_described">No es como se describe</option><option value="wrong_item">Producto equivocado</option><option value="changed_mind">Cambié de opinión</option><option value="other">Otro</option></select></div>
<div class="field"><label for="ret-note">Comentario (opcional)</label><textarea id="ret-note" name="note" rows="2" maxlength="500"></textarea></div>
<button class="btn" type="submit">Pedir devolución</button>
<p class="note" role="status" data-return-status></p>
</form></section>
{{else}}{{with .ReturnNote}}<p class="muted">{{.}}</p>{{end}}{{end}}
</div>
<aside class="summary" aria-label="Resumen del pedido"><h2>Resumen</h2>
<table class="totals"><tbody>
<tr><td>Productos</td><td class="num">{{.Items}}</td></tr>
{{with .Discounts}}<tr><td>Descuentos</td><td class="num">−{{.}}</td></tr>{{end}}
<tr><td>Envío</td><td class="num">{{.Shipping}}</td></tr>
{{range .Fees}}<tr><td>{{.Name}}</td><td class="num">{{.Amount}}</td></tr>{{end}}
<tr class="grand"><td>Total</td><td class="num">{{.Total}}</td></tr>
{{with .Refunded}}<tr><td>Reembolsado</td><td class="num">{{.}}</td></tr>{{end}}
{{with .Balance}}<tr><td>Saldo por pagar</td><td class="num">{{.}}</td></tr>{{end}}
</tbody></table>
{{with .Address}}<p class="muted">Se envía a: {{.}}</p>{{end}}
{{if .InvoiceURL}}<p><a class="btn btn-ghost" href="{{.InvoiceURL}}" rel="noopener noreferrer" target="_blank">Descargar factura</a></p>{{else}}<p class="muted">La factura aparecerá aquí cuando esté lista.</p>{{end}}
</aside>
</div>
{{end}}

{{else if eq .View "addresses"}}
{{range .Addresses}}
<section class="acct-box"><h2>{{if .Name}}{{.Name}}{{else}}Dirección{{end}}{{if .Default}} · principal{{end}}</h2>
<p>{{.Line1}}{{with .Line2}}, {{.}}{{end}}<br>{{with .City}}{{.}}, {{end}}{{with .State}}{{.}}, {{end}}C.P. {{.PostalCode}}{{with .Phone}}<br>{{.}}{{end}}</p>
<form method="post" action="{{$.Base}}/cuenta"><input type="hidden" name="accion" value="borrar-direccion"><input type="hidden" name="id" value="{{.ID}}"><button class="linkbtn" type="submit">Eliminar</button></form>
</section>
{{else}}<p class="empty">No tienes direcciones guardadas.</p>{{end}}
<div class="checkout"><form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="direccion">
<fieldset><legend>Agregar dirección</legend>
<div class="field"><label for="nombre">Quién recibe</label><input id="nombre" name="nombre" autocomplete="name" maxlength="120"></div>
<div class="field"><label for="calle">Calle y número</label><input id="calle" name="calle" autocomplete="address-line1" maxlength="200" required></div>
<div class="field"><label for="interior">Interior, colonia o referencias (opcional)</label><input id="interior" name="interior" autocomplete="address-line2" maxlength="200"></div>
<div class="field"><label for="cp">Código postal</label><input id="cp" name="cp" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required></div>
<div class="field"><label for="ciudad">Ciudad o alcaldía</label><input id="ciudad" name="ciudad" autocomplete="address-level2" maxlength="120" required></div>
<div class="field"><label for="estado">Estado</label><input id="estado" name="estado" autocomplete="address-level1" maxlength="120" required></div>
<div class="field"><label for="telefono">Teléfono (opcional)</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="30"></div>
<p><label><input type="checkbox" name="principal" value="1"> Usar como dirección principal</label></p>
<button class="btn" type="submit">Guardar dirección</button>
</fieldset></form></div>

{{else if eq .View "profile"}}
<div class="checkout"><div>
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="datos">
<fieldset><legend>Tus datos</legend>
<p class="muted">Correo: <strong>{{.Customer.Email}}</strong></p>
<div class="field"><label for="nombre">Nombre completo</label><input id="nombre" name="nombre" autocomplete="name" maxlength="120" value="{{.Customer.Name}}"></div>
<div class="field"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="30" value="{{.Customer.Phone}}"></div>
<p><label><input type="checkbox" name="novedades" value="1"{{if .Customer.MarketingConsent}} checked{{end}}> Quiero recibir novedades y ofertas por correo</label></p>
<button class="btn" type="submit">Guardar</button>
</fieldset></form>
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="contrasena">
<fieldset><legend>Contraseña (opcional)</legend>
<p class="muted">{{if .Customer.HasPassword}}Ya tienes contraseña. Escribe una nueva para cambiarla, o deja el campo vacío y guarda para quitarla.{{else}}Siempre puedes entrar con un código por correo. Si prefieres, crea una contraseña.{{end}}</p>
<div class="field"><label for="contrasena">Nueva contraseña (mínimo 10 caracteres)</label><input id="contrasena" name="contrasena" type="password" autocomplete="new-password" minlength="10" maxlength="200"></div>
<button class="btn btn-ghost" type="submit">Guardar contraseña</button>
</fieldset></form>
<fieldset><legend>Tus datos personales</legend>
<p class="muted">Puedes descargar una copia de todo lo que la tienda guarda sobre ti, o pedir que se borre.</p>
<p><a class="btn btn-ghost" href="/s/{{.Tenant}}/api/account/export" download>Descargar mis datos</a></p>
<details class="danger"><summary>Borrar mi cuenta</summary>
<form method="post" action="{{.Base}}/cuenta">
<input type="hidden" name="accion" value="borrar-cuenta">
<p class="muted">Se borran tu cuenta, direcciones, favoritos y datos personales. Tus pedidos se conservan sin tu nombre ni tu dirección, porque la tienda los necesita para su contabilidad. No se puede deshacer.</p>
<div class="field"><label for="confirmar">Escribe BORRAR para confirmar</label><input id="confirmar" name="confirmar" autocomplete="off" maxlength="10" required></div>
<button class="btn" type="submit">Borrar mi cuenta para siempre</button>
</form></details>
</fieldset>
</div></div>
{{end}}
{{end}}
</div>
{{end}}
