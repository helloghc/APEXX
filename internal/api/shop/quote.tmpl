{{define "content"}}
<div class="policy">
{{with .Q}}
<h1>Cotización #{{.Number}}</h1>
<div class="acct-box" data-quote="{{$.Token}}">
{{if .Offer}}
<table><thead><tr><th>Producto</th><th>Cantidad</th><th class="num">Precio</th><th class="num">Total</th></tr></thead><tbody>{{range .Offer.Items}}<tr><td>{{.Title}}</td><td>{{.Qty}}</td><td class="num">{{cents .Unit}}</td><td class="num">{{cents .Total}}</td></tr>{{end}}</tbody></table>
<table class="totals"><tbody>
<tr><td>Productos</td><td class="num">{{cents .Offer.ItemsTotal}}</td></tr>
{{if .Offer.Discount}}<tr><td>Descuento</td><td class="num">−{{cents .Offer.Discount}}</td></tr>{{end}}
<tr><td>Envío</td><td class="num">{{cents .Offer.Shipping}}</td></tr>
<tr class="grand"><td>Total</td><td class="num">{{cents .Offer.GrandTotal}}</td></tr>
</tbody></table>
{{else}}
<p class="muted">Recibimos tu solicitud. La tienda te enviará su oferta por correo.</p>
<ul>{{range $.Titles}}<li>{{.}}</li>{{end}}</ul>
{{end}}
{{if eq .Status "offered"}}
{{with .ExpiresAt}}<p class="muted">Vigente hasta el {{day .}}.</p>{{end}}
<div class="field"><label for="quote-msg">Mensaje (opcional)</label><textarea id="quote-msg" rows="3" maxlength="2000"></textarea></div>
<p class="note" role="status" data-quote-status></p>
<div class="subactions"><button class="btn" type="button" data-quote-act="accept">Aceptar cotización</button><button class="btn ghost" type="button" data-quote-act="changes">Pedir cambios</button><button class="btn ghost" type="button" data-quote-act="reject" data-confirm="¿Rechazar esta cotización?">Rechazar</button></div>
{{else if eq .Status "accepted"}}<p class="acct-ok">{{if .OrderID}}Aceptada. Tu pedido ya se colocó.{{else}}Aceptada. Completa el pago con el enlace que te enviamos.{{end}}</p>
{{else if eq .Status "requested"}}<p class="muted">La tienda está preparando tu cotización.</p>
{{else if eq .Status "rejected"}}<p class="muted">Rechazaste esta cotización.</p>
{{else if eq .Status "expired"}}<p class="muted">Esta cotización venció. Pide una nueva desde tu carrito.</p>
{{else}}<p class="muted">Esta cotización se canceló.</p>{{end}}
<p><a class="btn ghost" href="/s/{{$.Tenant}}/api/quotes/{{$.Token}}/pdf" download>Descargar PDF</a></p>
<h2>Comentarios por producto</h2>
{{if .Comments}}<ul class="history" data-line-comments>{{range .Comments}}<li><span class="muted">{{day .At}} · {{.SKU}}</span> · {{if eq .Who "buyer"}}Tú{{else}}La tienda{{end}}{{with .Author}} ({{.}}){{end}}: “{{.Body}}”</li>{{end}}</ul>{{else}}<p class="muted">Sin comentarios todavía.</p>{{end}}
{{if or (eq .Status "requested") (eq .Status "offered")}}<form class="acct-box" data-line-comment="{{$.Token}}"><div class="field"><label for="lc-sku">Producto</label><select id="lc-sku" name="sku">{{range $.Lines}}<option value="{{.SKU}}">{{.Title}}</option>{{end}}</select></div>
<div class="field"><label for="lc-body">Comentario</label><textarea id="lc-body" name="body" rows="2" maxlength="1000" required></textarea></div><button class="btn ghost" type="submit">Enviar comentario</button><p class="note" role="status" data-lc-status></p></form>{{end}}
{{if .History}}<h2>Historial</h2><ul class="history">{{range .History}}<li><span class="muted">{{day .At}}</span> · {{if eq .Who "buyer"}}Tú{{else}}La tienda{{end}}: {{if eq .Kind "requested"}}pediste la cotización{{else if eq .Kind "offered"}}envió una oferta{{else if eq .Kind "changes"}}pediste cambios{{else if eq .Kind "accepted"}}aceptaste{{else if eq .Kind "rejected"}}rechazaste{{else if eq .Kind "expired"}}venció{{else}}la canceló{{end}}{{with .Message}}: “{{.}}”{{end}}</li>{{end}}</ul>{{end}}
</div>
{{else}}
<h1>Cotización no encontrada</h1>
<p class="muted">Este enlace no es válido. Usa el botón del correo que recibiste.</p>
{{end}}
</div>
{{end}}
